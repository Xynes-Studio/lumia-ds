{
  "name": "lumia-ds-monorepo",
  "private": true,
  "description": "Lumia UI design-system library monorepo",
  "scripts": {
    "test": "pnpm -r test",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "lint": "eslint \"packages/**/*.{ts,tsx,js,jsx}\" --cache",
    "type-check": "tsc --build",
    "build": "pnpm -r build",
    "icons:import": "node packages/cli/bin/lumia-icon-import.js packages/icons/raw packages/icons",
    "coverage:all": "pnpm --filter @lumia-ui/components test && pnpm --filter @lumia-ui/editor test && pnpm --filter @lumia-ui/runtime exec vitest run --coverage && pnpm --filter @lumia-ui/forms exec vitest run --coverage && pnpm --filter @lumia-ui/layout exec vitest run --coverage && pnpm --filter @lumia-ui/theme test && pnpm --filter @lumia-ui/tokens test && pnpm --filter @lumia-ui/icons test",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:reset": "pnpm --filter @lumia-ui/tokens build && pnpm --filter @lumia-ui/theme build",
    "storybook:build": "storybook build -c .storybook",
    "lumia": "pnpm --filter @lumia-ui/cli exec node ./bin/lumia.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion@5.0.0": "5.0.1",
      "dompurify@3.3.1": "3.4.1",
      "flat-cache": "^4.0.1",
      "handlebars@4.7.8": "4.7.9",
      "minimatch@10.1.1": "10.2.3",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.4"
    }
  },
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@lumia-ui/theme": "workspace:*",
    "@lumia-ui/tokens": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/jest-axe": "^3.5.9",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "http-server": "14.1.1",
    "jest-axe": "^10.0.0",
    "next-mdx-import-source-file": "workspace:*",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "unplugin": "^1.16.1"
  }
}
